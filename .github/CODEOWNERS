# Mapping technique de la gouvernance du projet (voir docs/gouvernance.md pour le détail des
# rôles, la matrice RACI et le workflow de contribution). Les identifiants ci-dessous sont des
# rôles, pas des comptes GitHub réels -- ce fichier documente la répartition des responsabilités
# par dossier, à réassigner à de vrais comptes le jour où un rôle est pourvu par une personne
# distincte.

# Data Engineer -- sql/, etl/
/sql/      @role-data-engineer
/etl/      @role-data-engineer

# Data Scientist / ML Engineer -- analytics/
/analytics/  @role-data-scientist

# Backend Developer -- api/
/api/      @role-backend-developer

# Frontend Developer -- dashboard/
/dashboard/  @role-frontend-developer

# QA / DevOps -- tests/, CI, conteneurisation
/tests/                  @role-qa-devops
/.github/workflows/      @role-qa-devops
/docker-compose.yml      @role-qa-devops

# Référent RGPD & Sécurité -- transverse (endpoints RGPD de l'API + config des secrets)
/api/routers/rgpd.py  @role-rgpd-referent
/.env.example          @role-rgpd-referent

# Gouvernance et documentation -- Chef de projet
/docs/     @role-chef-de-projet
/README.md  @role-chef-de-projet
