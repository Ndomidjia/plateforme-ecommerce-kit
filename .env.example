# Copier ce fichier en .env et adapter les valeurs.
# Ne JAMAIS commiter le fichier .env (voir .gitignore) — bonne pratique sécurité/RGPD.
POSTGRES_USER=ecommerce_admin
POSTGRES_PASSWORD=changez_moi
POSTGRES_DB=ecommerce_platform
DATABASE_URL=postgresql+psycopg2://ecommerce_admin:changez_moi@localhost:5432/ecommerce_platform

# API (JWT) — générer une vraie clé aléatoire, ne jamais réutiliser celle-ci
JWT_SECRET_KEY=changez_moi_aussi
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Vault (gestion des secrets, voir docker-compose.yml service `vault` et
# docs/securite.md) -- mode dev uniquement. Générer un vrai token aléatoire
# (ex: python -c "import secrets; print(secrets.token_urlsafe(32))"),
# jamais la valeur ci-dessous. Optionnel : si absent, DATABASE_URL et
# JWT_SECRET_KEY ci-dessus sont utilisés directement (voir secrets_provider.py).
VAULT_DEV_ROOT_TOKEN=changez_moi_en_token_aleatoire
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=changez_moi_en_token_aleatoire

# Uniquement pour docker-compose.prod.yml (déploiement serveur, voir
# docs/deploiement.md) -- ignoré en dev local.
# Sous-domaine gratuit DuckDNS pointant vers l'IP publique du serveur, utilisé
# par Caddy (deploy/Caddyfile) pour le certificat HTTPS automatique.
DUCKDNS_DOMAIN=monprojet.duckdns.org
