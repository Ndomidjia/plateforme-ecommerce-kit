# Reverse proxy + HTTPS automatique (Let's Encrypt) pour mon domaine DuckDNS
# gratuit -- je n'ai pas de nom de domaine payant, voir docs/deploiement.md.
# {$DUCKDNS_DOMAIN} est lu depuis le .env du serveur (ex: monprojet.duckdns.org).
{$DUCKDNS_DOMAIN} {
	encode gzip

	# J'utilise des blocs `handle` explicitement ordonnés et mutuellement
	# exclusifs, plutôt que des directives top-level (reverse_proxy +
	# file_server/try_files) : Caddy réordonne les directives top-level selon
	# un ordre interne fixe (try_files passe AVANT reverse_proxy, quel que
	# soit l'ordre dans ce fichier), ce qui réécrivait silencieusement mes
	# routes API (/auth/login, /health...) vers index.html avant même que la
	# règle API ne soit évaluée -- incident que j'ai découvert en testant le
	# déploiement réel. Les blocs `handle` s'évaluent dans l'ordre du texte,
	# le premier qui matche l'emporte.
	handle /auth* /analytics* /admin* /rgpd* /health /docs* /openapi.json {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
